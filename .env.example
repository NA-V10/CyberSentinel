# =============================================================================
# CyberSentinel AI — Environment Variables Template
# Copy this file to .env (backend) and .env.frontend (Next.js) and fill in
# the real values.  Never commit the filled-in files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=CyberSentinel AI
DEBUG=false
API_V1_STR=/api/v1

# -----------------------------------------------------------------------------
# Database — PostgreSQL (async)
# Use postgresql+asyncpg:// for SQLAlchemy async engine
# For Supabase: postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
# For Neon:     postgresql+asyncpg://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://cybersentinel:cybersentinel_secret_2024@localhost:5432/cybersentinel

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# Leave QDRANT_API_KEY empty for local / self-hosted deployments
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cybersentinel_incidents

# -----------------------------------------------------------------------------
# Neo4j Graph Database
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cybersentinel123

# -----------------------------------------------------------------------------
# Clerk Authentication
# Obtain from https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_JWT_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# -----------------------------------------------------------------------------
# MCP Server (tool-calling gateway)
# -----------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8001
MCP_API_KEY=your-mcp-api-key

# -----------------------------------------------------------------------------
# Frontend — Next.js public environment variables
# These are injected into the browser bundle; do NOT put secrets here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# Machine-Learning model
# -----------------------------------------------------------------------------
ML_MODEL_PATH=models/threat_classifier.joblib

# -----------------------------------------------------------------------------
# Docker Compose — Postgres container environment
# Used by the postgres service; also referenced in DATABASE_URL above.
# -----------------------------------------------------------------------------
POSTGRES_DB=cybersentinel
POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=cybersentinel_secret_2024

# -----------------------------------------------------------------------------
# Docker Compose — Neo4j container auth
# Format: <username>/<password>
# -----------------------------------------------------------------------------
NEO4J_AUTH=neo4j/cybersentinel123
