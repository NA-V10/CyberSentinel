# =============================================================================
# CyberSentinel AI — Frontend (Next.js) Docker Environment
# Passed to the frontend container via env_file in docker-compose.yml.
#
# NEXT_PUBLIC_* variables are embedded into the browser bundle at build time.
# Do NOT store secrets in NEXT_PUBLIC_* variables.
# =============================================================================

# Clerk Auth (public key only — secret key must NOT be in frontend env)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Backend API — points at nginx which proxies to backend:8000
# In a Docker Compose setup with nginx, use the public nginx address.
# For direct frontend→backend (no nginx), use http://backend:8000.
NEXT_PUBLIC_API_URL=http://localhost:80
NEXT_PUBLIC_WS_URL=ws://localhost:80

# Node environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
